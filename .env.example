# Claude Code and the optional Anthropic Judge. Use either API-key or OAuth auth.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Together evaluation tasks and the optional Together sandbox (--sandbox together).
TOGETHER_API_KEY=

# Codex agents. Uncomment one supported credential when selecting Codex.
# CODEX_API_KEY=
# OPENAI_API_KEY=

# Optional E2B execution, the default `hurdle setup` sandbox. E2B_TEMPLATE is
# read only by `npm run runtime:init`.
# E2B_API_KEY=
# E2B_TEMPLATE=

# Optional Postgres result storage.
# HURDLE_RESULT_STORE_DATABASE_URL=postgresql://
