{
  "name": "hurdle",
  "version": "0.5.0",
  "description": "Run and inspect evidence-backed evaluations for coding agents.",
  "type": "module",
  "bin": {
    "hurdle": "./harness/bin/hurdle.mjs",
    "tae": "./harness/bin/tae.mjs"
  },
  "types": "./harness/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./harness/types/index.d.ts",
      "import": "./harness/index.mjs",
      "default": "./harness/index.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    ".env.example",
    "docs/authoring.md",
    "docs/cli-testing.md",
    "docs/beta-backends.md",
    "docs/assets/readme-hero.png",
    "examples/copy-message",
    "examples/together-api",
    "examples/concurrency-smoke",
    "examples/kitchen-sink",
    "docs/sandbox-setup.md",
    "docs/together-socket.md",
    "harness/bin",
    "harness/index.mjs",
    "harness/lib",
    "harness/local-result-store-reader.mjs",
    "harness/migrations",
    "harness/postgres-result-store-reader.mjs",
    "harness/types",
    "harness/verify/proxy/agent-node-runtime/package.json",
    "harness/verify/proxy/agent-node-runtime/package-lock.json",
    "harness/verify/proxy/generic_guardian.py",
    "harness/verify/proxy/guardian-node-runtime/package.json",
    "harness/verify/proxy/guardian-node-runtime/package-lock.json",
    "harness/verify/proxy/guardian-requirements.lock",
    "harness/verify/proxy/node_proxy_bootstrap.cjs",
    "harness/verify/proxy/python_proxy_bootstrap.py",
    "harness/verify/proxy/tcp_ws_bridge.cjs",
    "viewer/launcher.mjs",
    "viewer-runtime"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nutlope/hurdle.git"
  },
  "homepage": "https://github.com/Nutlope/hurdle#readme",
  "bugs": {
    "url": "https://github.com/Nutlope/hurdle/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "scripts": {
    "setup": "npm install && npm --prefix harness install && npm --prefix viewer install",
    "setup:ci": "npm ci && npm --prefix harness ci && npm --prefix viewer ci",
    "test": "npm --prefix harness test && npm --prefix viewer test",
    "tae": "node harness/bin/tae.mjs",
    "hurdle": "node harness/bin/hurdle.mjs",
    "preflight": "node harness/bin/preflight.mjs",
    "runtime:init": "node harness/bin/init-runtime.mjs",
    "together:image-context": "node harness/bin/together-image-context.mjs",
    "db:migrate": "node harness/bin/migrate-postgres-result-store.mjs",
    "quickstart": "node harness/bin/source-quickstart.mjs",
    "showcase": "npm run legacy --",
    "legacy": "node harness/bin/hurdle.mjs run evals/together/legacy.suite.mjs --runtime evals/together/runtime/local-judge.json --experiment-version together-legacy --view",
    "hybrid": "node harness/bin/hurdle.mjs run evals/together/hybrid.suite.mjs --runtime evals/together/runtime/local-judge.json --experiment-version together-hybrid --view",
    "chat-app": "node harness/bin/hurdle.mjs run evals/together/chat-app.suite.mjs --runtime evals/together/runtime/local-judge.json",
    "view": "node harness/bin/hurdle.mjs view",
    "build:viewer": "npm --prefix viewer run build",
    "stage:viewer": "node scripts/stage-viewer-runtime.mjs",
    "build": "npm run build:viewer && npm run stage:viewer",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "ws": "8.21.1"
  },
  "bundleDependencies": [
    "pg",
    "ws"
  ],
  "license": "MIT"
}
